# Database target -- MariaDB yang SAMA dengan dashboard-kinerja/kinerja (shared DB).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<user-mariadb>
DB_PASSWORD=<password-mariadb>
DB_NAME=<nama-database-sama-dengan-dashboard-kinerja>

# Beda dari SESSION_SECRET dashboard-kinerja -- jangan pernah dipakai ulang, dua app
# beda subdomain/cookie walau login pakai kredensial employees yang sama.
SESSION_SECRET=<string-acak-panjang>

APP_URL=http://localhost:3000

# Dipakai HANYA oleh scripts/migrate-from-cobakinerja.ts (migrasi Fase 1, sekali jalan).
# cobakinerja ada di VPS lama (Ubuntu 12.04, PHP 5.3) yang cuma bisa diakses lewat SSH
# tunnel -- lihat pola ~/Documents/GitHub/import-presensi-app/README.md bagian
# "Cara pakai bulanan" untuk cara buka tunnelnya. Isi host/port di bawah sesuai tunnel
# lokal (atau ke salinan lokal dump cobakinerja.sql kalau tidak butuh data ter-update).
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_USER=<user-mysql-cobakinerja>
SOURCE_DB_PASSWORD=<password-mysql-cobakinerja>
SOURCE_DB_NAME=cobakinerja
